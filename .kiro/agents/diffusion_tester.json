{
  "name": "diffusion_tester",
  "description": "Diffusion/Molecule testing specialist for running, validating, and troubleshooting Molecule test scenarios. Uses Diffusion MCP tools for test execution and diagnostics. Read-only access to role code.",
  "promptFile": "./diffusion_tester.prompt.md",
  "tools": [
    "read",
    "shell"
  ],
  "allowedTools": [
    "read"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "diffusion molecule --force",
        "diffusion molecule --lint",
        "diffusion molecule --verify",
        "diffusion molecule --idempotence",
        "diffusion molecule --destroy",
        "diffusion deps check",
        "diffusion deps sync",
        "diffusion deps resolve",
        "diffusion show",
        "diffusion --version",
        "diffusion cache list",
        "diffusion cache status",
        "diffusion artifact list",
        "docker ps",
        "docker ps -a",
        "docker images",
        "docker inspect",
        "docker logs",
        "git status",
        "git log --oneline -10",
        "git branch",
        "git diff --name-only",
        "git diff --stat"
      ]
    }
  },
  "resources": [
    "file://scenarios/*/molecule.yml",
    "file://scenarios/*/verify.yml",
    "file://scenarios/*/converge.yml",
    "file://scenarios/*/requirements.yml",
    "file://diffusion.toml",
    "file://diffusion.lock",
    "file://tasks/**",
    "file://defaults/**",
    "file://handlers/**",
    "file://templates/**",
    "file://vars/**",
    "file://meta/main.yml"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "git status --porcelain",
        "timeout_ms": 5000
      },
      {
        "command": "git branch --show-current",
        "timeout_ms": 5000
      },
      {
        "command": "docker ps --format '{{.Names}}' 2>/dev/null || echo 'Docker not available'",
        "timeout_ms": 10000
      }
    ]
  },
  "model": "claude-sonnet-4",
  "welcomeMessage": "Diffusion Tester ready. I can run Molecule scenarios, validate configs, inspect containers, and diagnose test failures. What do you need tested?"
}
