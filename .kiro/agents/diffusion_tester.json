{
  "name": "diffusion_tester",
  "description": "Diffusion/Molecule testing specialist for running, validating, and troubleshooting Molecule test scenarios. Uses Diffusion MCP tools for test execution and diagnostics. Read-only access to role code.",
  "promptFile": "./diffusion_tester.prompt.md",
  "mcpServers": {
    "diffusion": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "-v",
        "./:/project",
        "ghcr.io/polar-team/diffusion-mcp-server:latest-amd64"
      ],
      "autoApprove": [
        "get_diffusion_config",
        "get_lock_file",
        "get_diffusion_cli_reference",
        "get_server_version",
        "get_requirements_yml",
        "list_molecule_containers",
        "list_molecule_scenarios",
        "check_molecule_yml",
        "check_verify_yml",
        "check_docker_environment",
        "run_diffusion_command",
        "docker_exec_in_molecule",
        "docker_in_docker_in_molecule",
        "update_diffusion_docs"
      ]
    }
  },
  "tools": [
    "read",
    "shell",
    "write",
    "@diffusion"
  ],
  "allowedTools": [
    "read",
    "@diffusion"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "defaults/*",
        "vars/*",
        "diffusion.toml"
      ]
    },
    "shell": {
      "allowedCommands": [
        "diffusion molecule",
        "diffusion molecule --force",
        "diffusion molecule --lint",
        "diffusion molecule --verify",
        "diffusion molecule --verify --tags *",
        "diffusion molecule --idempotence",
        "diffusion molecule --idempotence --tags *",
        "diffusion molecule --destroy",
        "diffusion molecule --converge",
        "diffusion molecule --converge --foce",
        "diffusion molecule --converge --tags *",
        "diffusion molecule --wipe",
        "diffusion molecule --scenario default",
        "diffusion molecule --scenario default --force",
        "diffusion molecule --scenario default --lint",
        "diffusion molecule --scenario default --verify",
        "diffusion molecule --scenario default --verify --tags *",
        "diffusion molecule --scenario default --idempotence",
        "diffusion molecule --scenario default --idempotence --tags *",
        "diffusion molecule --scenario default --destroy",
        "diffusion molecule --scenario default --converge",
        "diffusion molecule --scenario default --converge --force",
        "diffusion molecule --scenario default --converge --tags *",
        "diffusion molecule --scenario multi",
        "diffusion molecule --scenario multi --force",
        "diffusion molecule --scenario multi --lint",
        "diffusion molecule --scenario multi --verify",
        "diffusion molecule --scenario multi --verify --tags *",
        "diffusion molecule --scenario multi --idempotence",
        "diffusion molecule --scenario multi --idempotence --tags *",
        "diffusion molecule --scenario multi --destroy",
        "diffusion molecule --scenario multi --converge",
        "diffusion molecule --scenario multi --converge --force",
        "diffusion molecule --scenario multi --converge --tags *",
        "diffusion deps lock",
        "diffusion deps check",
        "diffusion deps sync",
        "diffusion deps resolve",
        "diffusion show",
        "diffusion --version",
        "diffusion cache list",
        "diffusion cache status",
        "diffusion artifact list",
        "diffusion docs",
        "docker ps",
        "docker ps -a",
        "docker images",
        "docker inspect",
        "docker logs",
        "docker exec",
        "git status",
        "git log --oneline -10",
        "git branch",
        "git diff --name-only",
        "git diff --stat"
      ]
    }
  },
  "resources": [
    "file://scenarios/*/molecule.yml",
    "file://scenarios/*/verify.yml",
    "file://scenarios/*/converge.yml",
    "file://scenarios/*/requirements.yml",
    "file://diffusion.toml",
    "file://diffusion.lock",
    "file://tasks/**",
    "file://defaults/**",
    "file://handlers/**",
    "file://templates/**",
    "file://vars/**",
    "file://meta/main.yml",
    "skill://.kiro/skills/tester/SKILL.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "git status --porcelain",
        "timeout_ms": 5000
      },
      {
        "command": "git branch --show-current",
        "timeout_ms": 5000
      },
      {
        "command": "docker ps --format '{{.Names}}'",
        "timeout_ms": 10000
      },
      {
        "command": "diffusion --version",
        "timeout_ms": 5000
      }
    ]
  },
  "model": "claude-sonnet-5",
  "keyboardShortcut": "shift+d",
  "welcomeMessage": "Diffusion Tester ready. I can run Molecule scenarios, validate configs, inspect containers, and diagnose test failures. What do you need tested?"
}
