{
  "name": "ansible-specialist",
  "description": "Ansible role specialist for writing, reviewing, and refactoring tasks, handlers, templates, variables, defaults, and meta files. Manages the Check Point WAF agent and Docker installation role following Ansible best practices.",
  "promptFile": "./ansible-specialist.prompt.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [
    "read"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "tasks/**",
        "defaults/**",
        "handlers/**",
        "templates/**",
        "vars/**",
        "meta/**",
        "files/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "ansible-lint",
        "ansible-lint .",
        "yamllint .",
        "yamllint tasks/",
        "yamllint defaults/",
        "yamllint handlers/",
        "yamllint vars/",
        "yamllint meta/",
        "ansible-playbook --syntax-check",
        "diffusion deps check",
        "diffusion deps resolve",
        "diffusion deps sync",
        "diffusion show",
        "diffusion --version",
        "diffusion role add-collection",
        "diffusion role remove-collection",
        "diffusion role add-role",
        "diffusion role remove-role",
        "git status",
        "git log --oneline -10",
        "git branch",
        "git diff --name-only",
        "git diff --stat"
      ]
    }
  },
  "resources": [
    "file://tasks/**",
    "file://defaults/**",
    "file://handlers/**",
    "file://templates/**",
    "file://vars/**",
    "file://meta/main.yml",
    "file://files/**",
    "file://diffusion.toml",
    "file://diffusion.lock",
    "file://scenarios/*/molecule.yml",
    "file://scenarios/*/verify.yml"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "git status --porcelain",
        "timeout_ms": 5000
      },
      {
        "command": "git branch --show-current",
        "timeout_ms": 5000
      }
    ]
  },
  "subAgents": [
    "diffusion_tester"
  ],
  "model": "claude-sonnet-4",
  "welcomeMessage": "Ansible Specialist ready. I can help write, review, and refactor role tasks, handlers, templates, variables, and defaults. What do you need?"
}
